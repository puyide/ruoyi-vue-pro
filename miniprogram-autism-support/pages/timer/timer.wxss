/* pages/timer/timer.wxss */
.timer-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8F0 0%, #FFFFFF 100%);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: transparent;
}

.nav-back {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: var(--font-xl);
  color: var(--color-text-primary);
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.nav-placeholder {
  width: 64rpx;
}

/* 内容区 */
.timer-content {
  flex: 1;
  padding: var(--spacing-lg);
  display: flex;
  flex-direction: column;
}

/* 计时器显示区 */
.timer-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
}

/* 圆形计时器 */
.timer-circle-container {
  margin-bottom: var(--spacing-xl);
}

.timer-circle {
  width: 400rpx;
  height: 400rpx;
  position: relative;
}

.circle-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #F0F0F0;
}

.circle-progress {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: conic-gradient(
    var(--color, #FF7A45) 0deg,
    var(--color, #FF7A45) var(--progress, 360deg),
    transparent var(--progress, 360deg),
    transparent 360deg
  );
  transition: all 0.3s ease;
}

.circle-inner {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  bottom: 20rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.time-text {
  font-size: 80rpx;
  font-weight: 300;
  color: var(--color-text-primary);
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 4rpx;
}

.time-label {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-top: 8rpx;
}

/* 进度条 */
.progress-bar-container {
  width: 100%;
  max-width: 500rpx;
}

.progress-bar {
  height: 16rpx;
  background: var(--color-border);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 时长选择 */
.duration-section {
  margin-top: var(--spacing-xl);
}

.section-label {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  display: block;
  margin-bottom: var(--spacing-md);
  text-align: center;
}

.duration-options {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.duration-btn {
  padding: var(--spacing-md) var(--spacing-xl);
  background: var(--color-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  transition: all 0.3s ease;
  box-shadow: var(--shadow-sm);
}

.duration-btn.selected {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: white;
}

/* 自定义时长 */
.custom-duration {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-md);
  gap: var(--spacing-sm);
}

.custom-input {
  width: 160rpx;
  padding: var(--spacing-sm) var(--spacing-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  text-align: center;
  font-size: var(--font-md);
}

.custom-unit {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

/* 控制按钮 */
.control-section {
  margin-top: var(--spacing-xl);
  padding: var(--spacing-lg) 0;
}

.control-buttons {
  display: flex;
  justify-content: center;
  gap: var(--spacing-lg);
}

.control-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: none;
  font-size: var(--font-sm);
  transition: all 0.3s ease;
}

.control-btn::after {
  border: none;
}

.btn-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.reset-btn {
  background: var(--color-bg);
  color: var(--color-text-secondary);
}

.reset-btn[disabled] {
  opacity: 0.5;
}

.main-btn {
  width: 200rpx;
  height: 200rpx;
  box-shadow: var(--shadow-lg);
}

.main-btn.start {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: white;
}

.main-btn.pause {
  background: linear-gradient(135deg, #FF6B6B 0%, #EE5A5A 100%);
  color: white;
}

.main-btn:active {
  transform: scale(0.95);
}

/* 使用提示 */
.tips-card {
  margin-top: auto;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.tips-icon {
  margin-right: 8rpx;
}

.tips-title {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--color-text-primary);
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.tip-item {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  line-height: 1.6;
}

/* 完成弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.complete-modal {
  width: 500rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  text-align: center;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.complete-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: var(--spacing-md);
}

.complete-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.complete-desc {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

