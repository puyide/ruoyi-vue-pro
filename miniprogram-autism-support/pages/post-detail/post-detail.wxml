<!--pages/post-detail/post-detail.wxml-->
<view class="post-detail-page">
  <!-- 顶部导航 -->
  <view class="custom-nav">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <view class="nav-more" bindtap="showMore">
      <text class="more-icon">···</text>
    </view>
  </view>

  <scroll-view class="content-scroll" scroll-y>
    <!-- 帖子主体 -->
    <view class="post-main">
      <!-- 标题 -->
      <text class="post-title">{{post.title}}</text>
      
      <!-- 作者信息 -->
      <view class="author-section">
        <view class="avatar">
          <image wx:if="{{post.author.avatar}}" src="{{post.author.avatar}}" mode="aspectFill"></image>
          <text wx:else class="avatar-text">{{post.author.nickname[0]}}</text>
        </view>
        <view class="author-info">
          <text class="author-name">{{post.author.nickname}}</text>
          <text class="post-time">{{post.publishTime}}</text>
        </view>
      </view>

      <!-- 标签 -->
      <view class="post-tags">
        <view class="tag tag-primary" wx:for="{{post.tags}}" wx:key="*this">
          #{{item}}
        </view>
      </view>

      <!-- 正文 -->
      <view class="post-content">
        <rich-text nodes="{{post.content}}"></rich-text>
      </view>

      <!-- 图片 -->
      <view class="post-images" wx:if="{{post.images.length > 0}}">
        <image 
          wx:for="{{post.images}}" 
          wx:key="*this"
          src="{{item}}"
          mode="widthFix"
          class="post-image"
          bindtap="previewImage"
          data-url="{{item}}"
        ></image>
      </view>
    </view>

    <!-- AI 总结卡片 -->
    <view class="ai-summary-card card card-elevated" wx:if="{{post.aiAnalysis}}">
      <view class="ai-header">
        <text class="ai-icon">✨</text>
        <text class="ai-title">AI 总结</text>
      </view>
      
      <view class="ai-section">
        <view class="ai-section-header">
          <text class="section-icon">✓</text>
          <text class="section-title">关键步骤</text>
        </view>
        <view class="ai-list">
          <view class="ai-list-item" wx:for="{{post.aiAnalysis.keySteps}}" wx:key="*this">
            <text class="list-dot">•</text>
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="ai-section">
        <view class="ai-section-header">
          <text class="section-icon">⚠</text>
          <text class="section-title">注意事项</text>
        </view>
        <view class="ai-list">
          <view class="ai-list-item" wx:for="{{post.aiAnalysis.notes}}" wx:key="*this">
            <text class="list-dot">•</text>
            <text>{{item}}</text>
          </view>
        </view>
      </view>

      <view class="ai-section">
        <view class="ai-section-header">
          <text class="section-icon">👶</text>
          <text class="section-title">适用年龄</text>
        </view>
        <text class="ai-age">{{post.aiAnalysis.ageRange}}</text>
      </view>
    </view>

    <!-- 相关推荐 -->
    <view class="related-section" wx:if="{{relatedPosts.length > 0}}">
      <view class="section-header">
        <text class="section-title">相关经验帖子推荐</text>
      </view>
      <scroll-view class="related-scroll" scroll-x enable-flex>
        <view 
          class="related-card"
          wx:for="{{relatedPosts}}"
          wx:key="id"
          bindtap="goToPost"
          data-id="{{item.id}}"
        >
          <text class="related-title ellipsis-2">{{item.title}}</text>
          <view class="related-meta">
            <text class="related-tag">#{{item.tags[0]}}</text>
            <text class="related-count">{{item.viewCount}}阅读</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 评论区 -->
    <view class="comment-section">
      <view class="section-header">
        <text class="section-title">评论 ({{comments.length}})</text>
      </view>

      <view class="comment-list" wx:if="{{comments.length > 0}}">
        <view class="comment-item" wx:for="{{comments}}" wx:key="id">
          <view class="comment-avatar avatar avatar-sm">
            <text class="avatar-text">{{item.author.nickname[0]}}</text>
          </view>
          <view class="comment-content">
            <view class="comment-header">
              <text class="comment-author">{{item.author.nickname}}</text>
              <text class="comment-time">{{item.timeAgo}}</text>
            </view>
            <text class="comment-text">{{item.content}}</text>
            <view class="comment-actions">
              <view class="comment-action" catchtap="likeComment" data-id="{{item.id}}">
                <text class="action-icon">👍</text>
                <text>{{item.likeCount || '赞'}}</text>
              </view>
              <view class="comment-action" catchtap="replyComment" data-id="{{item.id}}">
                <text>回复</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="empty-comment" wx:else>
        <text>还没有评论，来说说你的想法吧</text>
      </view>
    </view>

    <!-- 底部留白 -->
    <view class="bottom-space"></view>
  </scroll-view>

  <!-- 底部评论栏 -->
  <view class="comment-bar safe-area-bottom">
    <view class="comment-input-wrapper">
      <input 
        class="comment-input"
        placeholder="说说你的想法..."
        value="{{commentText}}"
        bindinput="onCommentInput"
        confirm-type="send"
        bindconfirm="submitComment"
      />
    </view>
    <view class="send-btn {{commentText ? 'active' : ''}}" bindtap="submitComment">
      <text>发送</text>
    </view>
  </view>
</view>

