/* pages/institution-detail/institution-detail.wxss */
.institution-detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
}

.nav-back, .nav-share {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: var(--font-xl);
  color: var(--color-text-primary);
}

.share-icon {
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
}

/* 头图 */
.institution-cover {
  height: 400rpx;
}

.cover-swiper {
  height: 100%;
}

.cover-image {
  width: 100%;
  height: 100%;
}

/* 基本信息卡片 */
.info-card {
  margin: var(--spacing-md);
  margin-top: -40rpx;
  position: relative;
  z-index: 10;
}

.institution-name {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.institution-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: var(--spacing-lg);
}

.inst-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
}

.info-row {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) 0;
  border-bottom: 2rpx solid var(--color-border);
}

.info-row:last-child {
  border-bottom: none;
}

.info-icon {
  font-size: var(--font-md);
  margin-right: var(--spacing-sm);
}

.info-text {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.info-action {
  padding: var(--spacing-xs) var(--spacing-md);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-sm);
  border-radius: var(--radius-sm);
}

/* 评分卡片 */
.rating-card {
  margin: 0 var(--spacing-md) var(--spacing-md);
}

.rating-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.overall-rating {
  display: flex;
  align-items: center;
}

.rating-star {
  font-size: var(--font-lg);
  margin-right: 8rpx;
}

.rating-value {
  font-size: var(--font-xxl);
  font-weight: 600;
  color: #D68F00;
}

.rating-details {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.rating-item {
  display: flex;
  align-items: center;
}

.rating-label {
  width: 140rpx;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.rating-bar-wrapper {
  flex: 1;
  height: 12rpx;
  background: var(--color-border);
  border-radius: 6rpx;
  overflow: hidden;
  margin: 0 var(--spacing-md);
}

.rating-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--color-warning) 0%, #F4A900 100%);
  border-radius: 6rpx;
  transition: width 0.5s ease;
}

.rating-score {
  width: 60rpx;
  text-align: right;
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
}

/* 评价卡片 */
.review-card {
  margin: 0 var(--spacing-md) var(--spacing-md);
}

.section-header {
  display: flex;
  align-items: baseline;
  margin-bottom: var(--spacing-md);
}

.review-count {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-left: var(--spacing-sm);
}

.review-list {
  display: flex;
  flex-direction: column;
}

.review-item {
  padding: var(--spacing-md) 0;
  border-bottom: 2rpx solid var(--color-border);
}

.review-item:last-child {
  border-bottom: none;
}

.review-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.reviewer-info {
  display: flex;
  align-items: center;
}

.avatar-text {
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.reviewer-name {
  margin-left: var(--spacing-sm);
  font-size: var(--font-sm);
  color: var(--color-text-primary);
}

.review-rating {
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: #D68F00;
}

.mini-star {
  font-size: var(--font-xs);
  margin-right: 4rpx;
}

.review-content {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: block;
  margin-bottom: var(--spacing-xs);
}

.review-time {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.empty-review {
  text-align: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.view-all-btn {
  text-align: center;
  padding: var(--spacing-md);
  color: var(--color-primary);
  font-size: var(--font-sm);
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-top: 2rpx solid var(--color-border);
}

/* 底部留白 */
.bottom-space {
  height: 140rpx;
}

