<!--pages/thank-messages/thank-messages.wxml-->
<view class="thank-messages-page">
  <!-- 顶部导航 -->
  <view class="nav-header">
    <view class="nav-back" bindtap="goBack">
      <text class="back-icon">‹</text>
    </view>
    <text class="nav-title">收到的感谢</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:elif="{{isEmpty}}">
    <view class="empty-icon">💌</view>
    <text class="empty-title">暂无感谢私信</text>
    <text class="empty-desc">当你传递温暖后，会收到来自其他家长的感谢</text>
  </view>

  <!-- 消息列表 -->
  <view class="message-list" wx:else>
    <view class="message-item {{item.isRead ? '' : 'unread'}}" 
          wx:for="{{messages}}" 
          wx:key="id"
          bindtap="onMessageTap"
          data-id="{{item.id}}"
          data-itemid="{{item.itemId}}">
      
      <!-- 头像 -->
      <view class="message-avatar">
        <image wx:if="{{item.fromUserAvatar}}" src="{{item.fromUserAvatar}}" mode="aspectFill"/>
        <text wx:else class="avatar-text">{{item.fromUserNickname[0] || '匿'}}</text>
      </view>

      <!-- 内容区 -->
      <view class="message-content">
        <view class="message-header">
          <text class="message-sender">{{item.fromUserNickname || '匿名家长'}}</text>
          <text class="message-time">{{item.timeText}}</text>
        </view>
        
        <view class="message-body">
          <text class="message-text">{{item.message}}</text>
        </view>

        <view class="message-item-info" wx:if="{{item.itemTitle}}">
          <text class="item-icon">🎁</text>
          <text class="item-title">{{item.itemTitle}}</text>
        </view>
      </view>

      <!-- 未读标记 -->
      <view class="unread-dot" wx:if="{{!item.isRead}}"></view>
    </view>
  </view>

  <!-- 底部温暖提示 -->
  <view class="bottom-hint" wx:if="{{!isEmpty && !loading}}">
    <text class="hint-text">每一份感谢，都是温暖的见证 💝</text>
  </view>

  <!-- 安全区域 -->
  <view class="safe-area-bottom"></view>
</view>

