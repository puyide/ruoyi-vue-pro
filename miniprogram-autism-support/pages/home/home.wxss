/* pages/home/home.wxss */
.home-page {
  padding: var(--spacing-lg);
  padding-top: var(--spacing-md);
}

/* 搜索区域 */
.search-section {
  margin-bottom: var(--spacing-lg);
}

.search-bar {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-full);
  padding: 24rpx 32rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: var(--spacing-sm);
  opacity: 0.5;
}

.search-placeholder {
  color: var(--color-text-muted);
  font-size: var(--font-md);
}

/* 今日锦囊 */
.tip-card {
  background: linear-gradient(135deg, #FFF8F0 0%, #FFE4D9 100%);
  border: 2rpx solid rgba(255, 122, 69, 0.15);
  margin-bottom: var(--spacing-lg);
  position: relative;
  overflow: hidden;
}

.tip-card::before {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(255, 122, 69, 0.1) 0%, transparent 70%);
  border-radius: 50%;
}

.tip-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
  position: relative;
}

.tip-icon {
  font-size: 40rpx;
  margin-right: var(--spacing-sm);
}

.tip-title {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.tip-badge {
  background: var(--color-primary);
  color: white;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
  margin-left: var(--spacing-sm);
}

.tip-content {
  margin-bottom: var(--spacing-md);
}

.tip-main-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  line-height: 1.4;
}

.tip-advice {
  display: block;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.tip-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tip-source {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

.tip-arrow {
  display: flex;
  align-items: center;
  color: var(--color-primary);
  font-size: var(--font-sm);
}

.arrow-text {
  margin-right: 8rpx;
}

.arrow-icon {
  font-size: var(--font-lg);
}

/* 金刚区 */
.quick-entry-section {
  margin-bottom: var(--spacing-xl);
}

.quick-entry-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: var(--spacing-sm);
}

.quick-entry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm);
}

.entry-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.entry-icon-wrapper:active {
  transform: scale(0.95);
}

.entry-emoji {
  font-size: 40rpx;
}

.training-bg {
  background: linear-gradient(135deg, #FF7A45 0%, #FF9A66 100%);
}

.community-bg {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
}

.relay-bg {
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
}

.group-bg {
  background: linear-gradient(135deg, #00B894 0%, #55EFC4 100%);
}

.resource-bg {
  background: linear-gradient(135deg, #FDCB6E 0%, #FFE066 100%);
}

.entry-icon {
  width: 48rpx;
  height: 48rpx;
}

.entry-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  font-weight: 500;
  text-align: center;
}

/* 精选经验区域 */
.featured-section {
  margin-bottom: var(--spacing-lg);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  position: relative;
  padding-left: 20rpx;
}

.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

.section-more {
  display: flex;
  align-items: center;
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.more-arrow {
  font-size: var(--font-lg);
  margin-left: 4rpx;
}

/* 帖子卡片 */
.post-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.post-card {
  padding: var(--spacing-lg);
  transition: transform 0.2s ease;
}

.post-card:active {
  transform: scale(0.98);
}

.post-header {
  margin-bottom: var(--spacing-sm);
}

.post-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.5;
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: var(--spacing-md);
}

.post-summary {
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.ai-badge {
  display: inline-flex;
  align-items: center;
  font-size: var(--font-xs);
  color: var(--color-primary);
  margin-bottom: var(--spacing-xs);
}

.ai-icon {
  margin-right: 6rpx;
}

.summary-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.post-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.post-stats {
  display: flex;
  gap: var(--spacing-lg);
}

.stat-item {
  display: flex;
  align-items: center;
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.stat-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

.post-time {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}

