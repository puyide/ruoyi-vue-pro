/* pages/training-domain/training-domain.wxss */
.domain-page {
  min-height: 100vh;
  background: var(--color-bg);
}

/* 页面头部 */
.page-header {
  position: relative;
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-top: calc(var(--spacing-xl) + 20rpx);
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: 0 0 50rpx 50rpx;
}

.header-content {
  position: relative;
  z-index: 1;
}

.header-title {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: white;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.header-desc {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

/* 领域列表 */
.domain-list {
  padding: 0 var(--spacing-lg);
  margin-top: calc(-60rpx);
  position: relative;
  z-index: 2;
}

.domain-card {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-md);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.domain-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--domain-color, var(--color-primary));
}

.domain-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

.domain-left {
  margin-right: var(--spacing-lg);
}

.domain-icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  background: color-mix(in srgb, var(--domain-color, var(--color-primary)) 12%, white);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.domain-icon {
  font-size: 48rpx;
}

.domain-content {
  flex: 1;
}

.domain-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.domain-desc {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.domain-arrow {
  color: var(--color-text-muted);
  font-size: var(--font-xxl);
  margin-left: var(--spacing-md);
}

/* 底部提示 */
.page-footer {
  padding: var(--spacing-xl) var(--spacing-lg);
  padding-bottom: calc(var(--spacing-xl) + env(safe-area-inset-bottom));
}

.footer-tip {
  display: flex;
  align-items: flex-start;
  background: var(--color-warning-light);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
}

.tip-icon {
  font-size: var(--font-lg);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.tip-text {
  font-size: var(--font-sm);
  color: #B8860B;
  line-height: 1.6;
}

