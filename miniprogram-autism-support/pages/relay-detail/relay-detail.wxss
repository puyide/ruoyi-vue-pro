/* pages/relay-detail/relay-detail.wxss */
.relay-detail-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
}

.nav-back { width: 64rpx; }
.back-icon { font-size: var(--font-xl); color: var(--color-text-primary); }
.nav-title { font-size: var(--font-lg); font-weight: 600; }
.nav-share { color: var(--color-primary); font-size: var(--font-md); }

/* 内容滚动区 */
.content-scroll { flex: 1; }

/* 图片区域 */
.image-section {
  position: relative;
}

.image-swiper {
  height: 560rpx;
}

.item-image {
  width: 100%;
  height: 100%;
}

.placeholder-image {
  width: 100%;
  height: 100%;
  background: var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.placeholder-icon { font-size: 100rpx; }
.placeholder-text { font-size: var(--font-md); color: var(--color-text-muted); margin-top: var(--spacing-sm); }

.method-badge {
  position: absolute;
  top: var(--spacing-md);
  left: var(--spacing-md);
  padding: 8rpx 20rpx;
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  font-weight: 600;
  color: white;
}

.method-badge.give { background: #4CAF50; }
.method-badge.borrow { background: #2196F3; }
.method-badge.sell { background: #FF9800; }

/* 基本信息卡片 */
.info-card {
  margin: var(--spacing-md);
}

.item-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-lg);
  line-height: 1.4;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-lg);
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  margin-bottom: 4rpx;
}

.info-value {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 500;
}

.info-value.highlight {
  color: var(--color-primary);
}

.description-section {
  padding-top: var(--spacing-md);
  border-top: 2rpx solid var(--color-border);
}

.section-label {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.description-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.7;
}

/* 方式卡片 */
.method-card {
  margin: 0 var(--spacing-md) var(--spacing-md);
}

.method-header {
  margin-bottom: var(--spacing-md);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.method-info {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.method-item {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.method-icon {
  font-size: 36rpx;
  margin-right: var(--spacing-md);
}

.method-content { flex: 1; }

.method-type {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.method-desc {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

/* 发布者信息 */
.giver-card {
  margin: 0 var(--spacing-md) var(--spacing-md);
}

.giver-header {
  display: flex;
  align-items: center;
}

.avatar-text {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-primary);
}

.giver-info {
  margin-left: var(--spacing-md);
}

.giver-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
}

.publish-time {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

/* 提示卡片 */
.tip-card {
  display: flex;
  margin: 0 var(--spacing-md) var(--spacing-md);
  padding: var(--spacing-md);
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
}

.tip-icon {
  font-size: var(--font-lg);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.tip-content { flex: 1; }

.tip-title {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-xs);
}

.tip-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
  display: block;
  line-height: 1.6;
}

/* 底部操作栏 */
.action-bar {
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-top: 2rpx solid var(--color-border);
}

/* 申请弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.apply-modal {
  width: 600rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 2rpx solid var(--color-border);
}

.modal-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.modal-close {
  font-size: var(--font-xl);
  color: var(--color-text-muted);
  padding: var(--spacing-sm);
}

.modal-body {
  padding: var(--spacing-lg);
}

.form-item {
  margin-bottom: var(--spacing-md);
  position: relative;
}

.form-label {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.apply-textarea {
  width: 100%;
  height: 200rpx;
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  background: var(--color-bg);
  box-sizing: border-box;
}

.char-count {
  position: absolute;
  right: var(--spacing-md);
  bottom: var(--spacing-md);
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.warning-box {
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-md);
  background: #FFF3E0;
  border-radius: var(--radius-md);
}

.warning-icon {
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.warning-text {
  font-size: var(--font-sm);
  color: #E65100;
  line-height: 1.5;
}

.modal-footer {
  padding: var(--spacing-lg);
  padding-top: 0;
}

/* 成功弹窗 */
.success-modal {
  width: 500rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  text-align: center;
  animation: modalIn 0.3s ease;
}

.success-icon { font-size: 100rpx; display: block; margin-bottom: var(--spacing-md); }
.success-title { font-size: var(--font-xl); font-weight: 600; display: block; margin-bottom: var(--spacing-sm); }
.success-desc { font-size: var(--font-md); color: var(--color-text-secondary); }

.goto-myrelay {
  margin-top: var(--spacing-lg);
  font-size: var(--font-md);
  color: var(--color-primary);
}

/* 底部留白 */
.bottom-space { height: 160rpx; }

