/* pages/community/community.wxss */
.community-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 标签导航 */
.tabs-container {
  background: var(--color-card);
  padding: var(--spacing-md) 0;
  box-shadow: var(--shadow-sm);
  position: sticky;
  top: 0;
  z-index: 100;
}

.tabs-scroll {
  display: flex;
  white-space: nowrap;
  padding: 0 var(--spacing-md);
}

.tab-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-lg);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  position: relative;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.tab-active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: var(--color-primary);
  border-radius: 3rpx;
}

/* 帖子列表 */
.post-list-scroll {
  flex: 1;
  padding: var(--spacing-md);
}

.post-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.post-card {
  padding: var(--spacing-lg);
  transition: transform 0.2s ease;
}

.post-card:active {
  transform: scale(0.99);
}

/* 帖子头部 */
.post-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.author-info {
  display: flex;
  align-items: center;
}

.avatar-text {
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.author-meta {
  margin-left: var(--spacing-sm);
  display: flex;
  flex-direction: column;
}

.author-name {
  font-size: var(--font-sm);
  color: var(--color-text-primary);
  font-weight: 500;
}

.post-time {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  margin-top: 4rpx;
}

/* 帖子内容 */
.post-content {
  margin-bottom: var(--spacing-md);
}

.post-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.5;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.post-tags {
  display: flex;
  flex-wrap: wrap;
}

/* AI 摘要 */
.ai-summary-box {
  background: linear-gradient(135deg, #F8F4FF 0%, #EEE9FF 100%);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-md);
  position: relative;
}

.ai-summary-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.ai-icon {
  font-size: var(--font-md);
  margin-right: 8rpx;
}

.ai-label {
  font-size: var(--font-xs);
  color: var(--color-secondary);
  font-weight: 500;
}

.ai-summary-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.expand-btn {
  position: absolute;
  right: var(--spacing-md);
  bottom: var(--spacing-md);
  font-size: var(--font-xs);
  color: var(--color-secondary);
}

/* 帖子底部 */
.post-footer {
  display: flex;
  gap: var(--spacing-xl);
  padding-top: var(--spacing-md);
  border-top: 2rpx solid var(--color-border);
}

.action-btn {
  display: flex;
  align-items: center;
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.action-btn:active {
  color: var(--color-primary);
}

.action-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

.action-count {
  margin-left: 8rpx;
  font-size: var(--font-xs);
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin-right: var(--spacing-sm);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.no-more {
  text-align: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

/* 发布按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.fab-inner {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 122, 69, 0.4);
  transition: transform 0.2s ease;
}

.fab-inner:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 56rpx;
  color: white;
  font-weight: 300;
  line-height: 1;
}

/* 底部留白 */
.bottom-space {
  height: 120rpx;
}

