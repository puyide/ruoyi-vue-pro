/* pages/relay-publish/relay-publish.wxss */
.relay-publish-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-bottom: 2rpx solid var(--color-border);
}

.nav-left {
  display: flex;
  align-items: center;
  color: var(--color-text-secondary);
  font-size: var(--font-md);
}

.back-icon {
  font-size: var(--font-xl);
  margin-right: 8rpx;
}

.publish-btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  background: var(--color-border);
  color: var(--color-text-muted);
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  font-weight: 500;
  transition: all 0.3s ease;
}

.publish-btn.active {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: white;
}

/* 表单滚动区 */
.form-scroll {
  flex: 1;
  padding: var(--spacing-lg);
}

/* 表单区块 */
.form-section {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-required {
  margin-left: var(--spacing-sm);
  font-size: var(--font-xs);
  color: var(--color-danger);
}

/* 图片上传 */
.image-upload-area {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-md);
}

.uploaded-image {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
}

.uploaded-image image {
  width: 100%;
  height: 100%;
}

.remove-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: var(--font-md);
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  border: 2rpx dashed var(--color-border);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
}

.upload-btn:active {
  border-color: #4CAF50;
  background: #E8F5E9;
}

.upload-icon { font-size: 48rpx; margin-bottom: 8rpx; }
.upload-text { font-size: var(--font-sm); }
.upload-count { font-size: var(--font-xs); margin-top: 4rpx; }

.upload-tip {
  display: block;
  margin-top: var(--spacing-md);
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 表单项 */
.form-item {
  margin-bottom: var(--spacing-lg);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.required {
  color: var(--color-danger);
}

.form-input {
  width: 100%;
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  background: var(--color-bg);
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  background: var(--color-bg);
  box-sizing: border-box;
}

.char-count {
  display: block;
  text-align: right;
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 选项组 */
.option-group {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.option-item {
  padding: var(--spacing-sm) var(--spacing-lg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  transition: all 0.3s ease;
}

.option-item.selected {
  background: #E8F5E9;
  border-color: #4CAF50;
  color: #4CAF50;
}

/* 方式选项 */
.method-options {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.method-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  transition: all 0.3s ease;
}

.method-item.selected {
  border-color: #4CAF50;
  background: #E8F5E9;
}

.method-icon {
  font-size: 36rpx;
  margin-right: var(--spacing-md);
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
}

.method-desc {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

.method-check {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-sm);
}

/* 提示信息 */
.tip-box {
  display: flex;
  padding: var(--spacing-md);
  background: var(--color-primary-light);
  border-radius: var(--radius-md);
  margin-top: var(--spacing-md);
}

.tip-icon {
  font-size: var(--font-lg);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.tip-content { flex: 1; }

.tip-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  line-height: 1.6;
}

/* 底部留白 */
.bottom-space { height: 60rpx; }

