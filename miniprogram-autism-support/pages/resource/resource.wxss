/* pages/resource/resource.wxss */
.resource-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-bottom: 2rpx solid var(--color-border);
}

.city-selector {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-md);
}

.city-name {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-right: 8rpx;
}

.city-arrow {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.filter-btn {
  display: flex;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  color: var(--color-text-secondary);
  font-size: var(--font-sm);
}

.filter-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  opacity: 0.6;
}

/* 标签筛选 */
.tag-filter {
  display: flex;
  white-space: nowrap;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
}

.filter-tag {
  display: inline-flex;
  padding: var(--spacing-sm) var(--spacing-lg);
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.filter-tag.active {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

/* 机构列表 */
.institution-scroll {
  flex: 1;
  padding: var(--spacing-md);
}

.institution-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.institution-card {
  padding: 0;
  overflow: hidden;
}

.institution-card:active {
  transform: scale(0.99);
}

.institution-image-wrapper {
  width: 100%;
  height: 240rpx;
}

.institution-image {
  width: 100%;
  height: 100%;
}

.institution-info {
  padding: var(--spacing-md);
}

.institution-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.institution-name {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  flex: 1;
}

.rating-badge {
  display: flex;
  align-items: center;
  background: var(--color-warning-light);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
}

.rating-star {
  font-size: var(--font-sm);
  margin-right: 4rpx;
}

.rating-value {
  font-size: var(--font-sm);
  font-weight: 600;
  color: #D68F00;
}

.institution-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: var(--spacing-sm);
}

.inst-tag {
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

.institution-meta {
  margin-bottom: var(--spacing-sm);
}

.meta-row {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.meta-icon {
  font-size: var(--font-sm);
  margin-right: 8rpx;
}

.meta-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.quick-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.highlight-tag {
  font-size: var(--font-xs);
  color: var(--color-success);
  background: var(--color-success-light);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
}

/* 加载更多 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin-right: var(--spacing-sm);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl) 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: var(--spacing-md);
}

.empty-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  margin-bottom: var(--spacing-xs);
}

.empty-tip {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

/* 城市选择器 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.picker-content {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--spacing-lg);
  max-height: 70vh;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.picker-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.picker-close {
  font-size: var(--font-xl);
  color: var(--color-text-muted);
  padding: var(--spacing-sm);
}

.city-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.city-item {
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.city-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}

