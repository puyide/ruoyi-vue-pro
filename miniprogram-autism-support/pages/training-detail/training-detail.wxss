/* pages/training-detail/training-detail.wxss */
.training-detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  flex-shrink: 0;
}

.nav-back {
  width: 64rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: var(--font-xl);
  color: var(--color-text-primary);
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.nav-placeholder {
  width: 64rpx;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-sm);
  color: var(--color-text-muted);
}

/* AI生成中状态 */
.generating-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.ai-animation {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-xl);
}

.ai-emoji {
  font-size: 80rpx;
  position: relative;
  z-index: 1;
  animation: bounce 1s ease-in-out infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.ai-pulse {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--color-primary-light);
  animation: pulse 1.5s ease-out infinite;
}

@keyframes pulse {
  0% { transform: scale(0.8); opacity: 1; }
  100% { transform: scale(1.5); opacity: 0; }
}

.generating-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  text-align: center;
}

.generating-desc {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-lg);
  text-align: center;
}

.generating-dots {
  display: flex;
  gap: 12rpx;
}

.generating-dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary);
  animation: dotBounce 1.4s ease-in-out infinite;
}

.generating-dots .dot:nth-child(2) {
  animation-delay: 0.2s;
}

.generating-dots .dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes dotBounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

/* 内容滚动区 */
.content-scroll {
  flex: 1;
}

/* 任务信息头 */
.task-header-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  padding: var(--spacing-xl);
  text-align: center;
  color: white;
  position: relative;
  overflow: hidden;
}

.task-header-card::before {
  content: '';
  position: absolute;
  top: -80rpx;
  right: -80rpx;
  width: 250rpx;
  height: 250rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.task-header-card::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  left: -50rpx;
  width: 150rpx;
  height: 150rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.task-icon-large {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto var(--spacing-md);
  font-size: 56rpx;
  position: relative;
}

.task-title {
  font-size: var(--font-xxl);
  font-weight: 600;
  display: block;
  margin-bottom: var(--spacing-md);
  position: relative;
}

/* 难度等级选择器 */
.level-selector {
  display: flex;
  justify-content: center;
  gap: var(--spacing-sm);
  margin-bottom: var(--spacing-md);
  position: relative;
}

.level-btn {
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: var(--radius-full);
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.level-btn.active {
  background: white;
  color: var(--color-primary);
  font-weight: 600;
}

.task-meta {
  display: flex;
  justify-content: center;
  gap: var(--spacing-lg);
  position: relative;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  opacity: 0.9;
}

.meta-icon {
  margin-right: 8rpx;
}

/* 通用卡片样式 */
.section-card {
  background: var(--color-card);
  margin: var(--spacing-md) var(--spacing-lg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.section-title {
  display: flex;
  align-items: center;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
}

.title-icon {
  margin-right: var(--spacing-sm);
  font-size: var(--font-lg);
}

/* 训练目标 */
.goal-text {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
}

.success-criteria {
  display: flex;
  align-items: flex-start;
  background: var(--color-success-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-top: var(--spacing-md);
}

.criteria-label {
  font-size: var(--font-sm);
  font-weight: 600;
  color: var(--color-success);
  flex-shrink: 0;
  margin-right: var(--spacing-xs);
}

.criteria-text {
  font-size: var(--font-sm);
  color: var(--color-success);
  line-height: 1.5;
}

/* 准备材料 */
.materials-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.material-item {
  display: flex;
  align-items: center;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.material-dot {
  color: var(--color-primary);
  font-weight: bold;
  margin-right: var(--spacing-sm);
}

/* 步骤区域 */
.steps-section {
  padding: 0 var(--spacing-lg);
  margin-top: var(--spacing-md);
}

.step-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.step-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.step-header {
  margin-bottom: var(--spacing-md);
}

.step-number-badge {
  display: inline-flex;
  padding: 6rpx 16rpx;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  border-radius: var(--radius-full);
}

.step-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.step-desc {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
}

.step-image {
  width: 100%;
  height: 300rpx;
  border-radius: var(--radius-md);
  margin-top: var(--spacing-md);
}

.step-tips {
  display: flex;
  align-items: flex-start;
  background: var(--color-warning-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-top: var(--spacing-md);
}

.tips-icon {
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.tips-text {
  font-size: var(--font-sm);
  color: #B8860B;
  line-height: 1.6;
}

/* 注意事项 */
.notes-section {
  padding: var(--spacing-md) var(--spacing-lg);
}

.notes-list {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
}

.note-item {
  display: flex;
  align-items: flex-start;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: var(--spacing-sm);
}

.note-item:last-child {
  margin-bottom: 0;
}

.note-dot {
  color: var(--color-primary);
  margin-right: var(--spacing-sm);
  font-weight: bold;
}

/* AI生成提示 */
.ai-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md);
  margin: var(--spacing-md) var(--spacing-lg);
}

.ai-icon {
  margin-right: var(--spacing-xs);
}

.ai-text {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 底部操作栏 */
.action-bar {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-top: 2rpx solid var(--color-border);
  flex-shrink: 0;
}

.flex-1 {
  flex: 1;
}

/* 底部留白 */
.bottom-space {
  height: 140rpx;
}
