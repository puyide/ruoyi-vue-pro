/* pages/group-detail/group-detail.wxss */
.group-detail-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-bottom: 2rpx solid var(--color-border);
}

.nav-back, .nav-more {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: var(--font-xl);
  color: var(--color-text-primary);
}

.more-icon {
  font-size: var(--font-lg);
  color: var(--color-text-secondary);
}

.nav-center {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.nav-member {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 今日话题卡片 */
.topic-card {
  margin: var(--spacing-md);
  background: linear-gradient(135deg, #FFF8F0 0%, #FFE4D9 100%);
  border: 2rpx solid rgba(255, 122, 69, 0.15);
}

.topic-header {
  margin-bottom: var(--spacing-md);
}

.topic-badge {
  background: var(--color-primary);
  color: white;
  font-size: var(--font-xs);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
}

.topic-question {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-md);
  line-height: 1.5;
}

.topic-examples {
  margin-bottom: var(--spacing-md);
}

.example-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.example-text {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  display: block;
  line-height: 1.6;
}

/* 消息滚动区 */
.message-scroll {
  flex: 1;
  padding: var(--spacing-md);
}

.load-more-tip {
  text-align: center;
  padding: var(--spacing-md);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.message-item {
  display: flex;
  align-items: flex-start;
}

.message-item.mine {
  flex-direction: row-reverse;
}

.avatar-text {
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 600;
}

.message-content {
  max-width: 75%;
  margin: 0 var(--spacing-sm);
}

.message-item.mine .message-content {
  align-items: flex-end;
}

.message-header {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.message-author {
  font-size: var(--font-sm);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-right: var(--spacing-sm);
}

.message-time {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.message-bubble {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.message-item.mine .message-bubble {
  background: var(--color-primary);
}

.message-text {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.6;
}

.message-item.mine .message-text {
  color: white;
}

/* 图片消息 */
.message-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: var(--spacing-sm);
}

.message-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: var(--radius-md);
}

/* 消息互动 */
.message-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-sm);
}

.action-item {
  display: flex;
  align-items: center;
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
}

.action-item:active {
  background: var(--color-primary-light);
}

.action-icon {
  margin-right: 4rpx;
}

.action-count {
  margin-left: 4rpx;
}

/* 底部输入栏 */
.input-bar {
  display: flex;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
  border-top: 2rpx solid var(--color-border);
  gap: var(--spacing-sm);
}

.input-wrapper {
  flex: 1;
  background: var(--color-bg);
  border-radius: var(--radius-full);
  padding: var(--spacing-sm) var(--spacing-lg);
}

.message-input {
  width: 100%;
  font-size: var(--font-md);
}

.input-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: var(--font-xl);
}

.send-btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  background: var(--color-border);
  color: var(--color-text-muted);
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  transition: all 0.3s ease;
}

.send-btn.active {
  background: var(--color-primary);
  color: white;
}

/* 底部留白 */
.bottom-space {
  height: 40rpx;
}

/* 交流空间入口卡片 */
.chat-entry-card {
  margin: var(--spacing-md);
  display: flex;
  align-items: center;
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border: 2rpx solid rgba(76, 175, 80, 0.2);
}

.chat-entry-icon {
  font-size: 48rpx;
  margin-right: var(--spacing-md);
}

.chat-entry-content {
  flex: 1;
}

.chat-entry-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
}

.chat-entry-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4rpx;
}

.chat-entry-btn {
  background: #4CAF50;
  color: white;
  font-size: var(--font-sm);
  padding: 16rpx 28rpx;
  border-radius: var(--radius-full);
  border: none;
  line-height: 1.4;
  white-space: nowrap;
}

.chat-entry-btn::after {
  border: none;
}

/* 微信群二维码弹窗 */
.qr-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.qr-modal-content {
  width: 80%;
  max-width: 600rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.qr-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  border-bottom: 2rpx solid var(--color-border);
}

.qr-modal-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.qr-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xl);
  color: var(--color-text-muted);
}

.qr-modal-body {
  padding: var(--spacing-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-code-image {
  width: 400rpx;
  height: 400rpx;
  border-radius: var(--radius-lg);
  background: #f5f5f5;
}

.qr-tips {
  margin-top: var(--spacing-lg);
  text-align: center;
}

.qr-tip {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.qr-expire-tip {
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm) var(--spacing-md);
  background: #FFF3E0;
  border-radius: var(--radius-sm);
}

.qr-expire-tip text {
  font-size: var(--font-xs);
  color: #E65100;
}

.qr-modal-footer {
  padding: var(--spacing-lg);
  padding-top: 0;
}

.qr-modal-footer .btn {
  width: 100%;
}

/* 风控轻提示 */
.risk-tip {
  text-align: center;
  padding: var(--spacing-sm) var(--spacing-lg);
  margin: 0 var(--spacing-md);
}

.risk-tip text {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 已退出交流区情绪兜底提示 */
.left-chat-tip {
  margin: var(--spacing-md);
  display: flex;
  align-items: flex-start;
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, #F3F7F5 0%, #E8F0EC 100%);
  border: 2rpx solid rgba(129, 178, 154, 0.2);
}

.left-chat-icon {
  font-size: 40rpx;
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.left-chat-content {
  flex: 1;
}

.left-chat-title {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 8rpx;
}

.left-chat-desc {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  line-height: 1.6;
}

.left-chat-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xl);
  color: var(--color-text-muted);
  flex-shrink: 0;
}

/* 交流区确认弹窗（合规关键节点） */
.confirm-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.confirm-modal-content {
  width: 85%;
  max-width: 640rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
}

.confirm-modal-header {
  padding: var(--spacing-xl) var(--spacing-xl) var(--spacing-md);
  text-align: center;
}

.confirm-modal-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.confirm-modal-body {
  padding: 0 var(--spacing-xl) var(--spacing-xl);
}

.confirm-modal-intro {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  line-height: 1.7;
  display: block;
  margin-bottom: var(--spacing-lg);
}

.confirm-modal-notice {
  background: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.notice-title {
  font-size: var(--font-md);
  font-weight: 500;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.notice-item {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  display: block;
  line-height: 1.8;
}

.confirm-modal-footer-text {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  display: block;
  text-align: center;
}

.confirm-modal-footer {
  display: flex;
  border-top: 2rpx solid var(--color-border);
}

.confirm-btn-secondary,
.confirm-btn-primary {
  flex: 1;
  padding: var(--spacing-lg);
  border: none;
  font-size: var(--font-md);
  font-weight: 500;
  background: transparent;
  line-height: 1.5;
}

.confirm-btn-secondary::after,
.confirm-btn-primary::after {
  border: none;
}

.confirm-btn-secondary {
  color: var(--color-text-secondary);
  border-right: 2rpx solid var(--color-border);
}

.confirm-btn-primary {
  color: var(--color-primary);
}

/* 欢迎语预览 */
.welcome-preview {
  margin-top: var(--spacing-lg);
  padding: var(--spacing-lg);
  background: linear-gradient(135deg, #F0F7F4 0%, #E3F0E9 100%);
  border-radius: var(--radius-lg);
  border: 2rpx solid rgba(129, 178, 154, 0.2);
}

.welcome-title {
  font-size: var(--font-sm);
  font-weight: 500;
  color: #5A8F71;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.welcome-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: block;
}

