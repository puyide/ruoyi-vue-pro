/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* 顶部区域 */
.login-header {
  position: relative;
  height: 400rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(135deg, var(--color-primary) 0%, #FF9A6C 50%, var(--color-primary-dark) 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-bg::before {
  content: '';
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 300rpx;
  height: 300rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-bg::after {
  content: '';
  position: absolute;
  bottom: -50rpx;
  left: -80rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 50%;
}

.logo-container {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 100rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.logo-icon {
  font-size: 60rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 12rpx;
}

/* 登录内容区 */
.login-content {
  flex: 1;
  margin: -40rpx var(--spacing-lg) 0;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl) var(--spacing-lg);
  box-shadow: var(--shadow-lg);
  position: relative;
  z-index: 20;
}

/* 登录方式切换标签 */
.login-tabs {
  display: flex;
  background: var(--color-bg);
  border-radius: var(--radius-full);
  padding: 6rpx;
  margin-bottom: var(--spacing-xl);
}

.login-tabs .tab {
  flex: 1;
  text-align: center;
  padding: var(--spacing-md) 0;
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  border-radius: var(--radius-full);
  transition: all 0.3s ease;
}

.login-tabs .tab.active {
  background: var(--color-card);
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: var(--shadow-sm);
}

/* 微信登录区域 */
.wechat-login-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
}

.wechat-icon {
  width: 120rpx;
  height: 120rpx;
  background: #E8F5E9;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.wechat-icon .icon {
  font-size: 56rpx;
}

.wechat-tip {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.wechat-desc {
  font-size: var(--font-sm);
  color: var(--color-text-muted);
  margin-bottom: var(--spacing-xl);
}

.btn-wechat {
  background: linear-gradient(135deg, #07C160 0%, #05A34C 100%);
  color: white;
  margin-top: var(--spacing-lg);
}

.btn-wechat:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 手机号登录表单 */
.login-form .input-group {
  margin-bottom: var(--spacing-lg);
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 0 var(--spacing-md);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-wrapper:focus-within {
  border-color: var(--color-primary);
  background: white;
}

.input-prefix {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  margin-right: var(--spacing-sm);
  padding-right: var(--spacing-sm);
  border-right: 2rpx solid var(--color-border);
}

.phone-input {
  flex: 1;
  height: 96rpx;
  font-size: var(--font-md);
  border: none;
  background: transparent;
}

.code-input {
  flex: 1;
  height: 96rpx;
  font-size: var(--font-md);
  border: none;
  background: transparent;
}

.clear-btn {
  width: 44rpx;
  height: 44rpx;
  background: var(--color-border);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.sms-btn {
  background: transparent;
  border: none;
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 500;
  padding: var(--spacing-sm) var(--spacing-md);
  white-space: nowrap;
  line-height: 1;
}

.sms-btn::after {
  border: none;
}

.sms-btn.disabled {
  color: var(--color-text-muted);
}

.login-btn {
  margin-top: var(--spacing-xl);
  height: 96rpx;
  font-size: var(--font-lg);
}

/* 协议区域 */
.agreement-area {
  display: flex;
  align-items: flex-start;
  margin-top: var(--spacing-lg);
  padding: 0 var(--spacing-sm);
}

.checkbox-wrapper {
  padding: 4rpx;
}

.checkbox {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: white;
  transition: all 0.3s ease;
}

.checkbox.checked {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.agreement-text {
  flex: 1;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
  margin-left: var(--spacing-sm);
  line-height: 1.6;
}

.agreement-text .link {
  color: var(--color-primary);
}

/* 其他登录方式 */
.other-login {
  padding: var(--spacing-xl) var(--spacing-lg);
}

.divider-with-text {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-lg);
}

.divider-line {
  flex: 1;
  height: 2rpx;
  background: var(--color-border);
}

.divider-text {
  padding: 0 var(--spacing-md);
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.other-login-btns {
  display: flex;
  justify-content: center;
}

.other-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-xl);
}

.other-btn:active {
  opacity: 0.7;
}

.other-icon {
  width: 80rpx;
  height: 80rpx;
  background: var(--color-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: var(--spacing-sm);
}

.other-text {
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

/* 底部 */
.login-footer {
  padding: var(--spacing-lg);
  text-align: center;
}

.footer-text {
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

/* 按钮通用样式 */
button {
  margin: 0;
}

button::after {
  border: none;
}

