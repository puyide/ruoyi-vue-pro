/* pages/training-execute/training-execute.wxss */
.execute-page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  display: flex;
  flex-direction: column;
}

/* 状态栏占位 */
.status-bar {
  height: 44px;
  flex-shrink: 0;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  flex-shrink: 0;
}

.nav-back {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon {
  font-size: var(--font-lg);
  color: white;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: white;
}

.nav-placeholder {
  width: 64rpx;
}

/* 加载状态 */
.loading-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.8);
}

/* 计时器区域 */
.timer-section {
  padding: var(--spacing-xl) var(--spacing-lg);
  text-align: center;
}

.timer-display {
  margin-bottom: var(--spacing-lg);
}

.timer-time {
  font-size: 120rpx;
  font-weight: 700;
  color: white;
  font-family: 'SF Mono', 'Menlo', monospace;
  letter-spacing: 4rpx;
  display: block;
  text-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.2);
}

.timer-label {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.7);
}

.timer-controls {
  display: flex;
  justify-content: center;
  margin-bottom: var(--spacing-lg);
}

.timer-btn {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: white;
  transition: all 0.2s ease;
}

.timer-btn.start {
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.timer-btn.pause {
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid white;
}

.timer-btn:active {
  transform: scale(0.95);
}

/* 成功计数 */
.success-counter {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--spacing-xl);
  background: rgba(255, 255, 255, 0.15);
  border-radius: var(--radius-xl);
  padding: var(--spacing-lg) var(--spacing-xl);
}

.counter-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.counter-value {
  font-size: var(--font-xxl);
  font-weight: 700;
  color: white;
}

.counter-value.success {
  color: #7CFC00;
}

.counter-label {
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

.counter-divider {
  width: 2rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 步骤进度指示器 */
.progress-indicator {
  display: flex;
  justify-content: center;
  gap: var(--spacing-sm);
  padding: var(--spacing-md) var(--spacing-lg);
}

.progress-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-xs);
  color: rgba(255, 255, 255, 0.6);
  transition: all 0.3s ease;
}

.progress-dot.active {
  background: rgba(255, 255, 255, 0.4);
  color: white;
}

.progress-dot.current {
  background: white;
  color: var(--color-primary);
  font-weight: 600;
  transform: scale(1.1);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

/* 当前步骤内容 */
.step-content {
  flex: 1;
  background: var(--color-bg);
  border-radius: 40rpx 40rpx 0 0;
  padding: var(--spacing-xl) var(--spacing-lg);
  margin-top: var(--spacing-md);
}

.step-card {
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-md);
  min-height: 300rpx;
}

.step-badge {
  display: inline-block;
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-xs);
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: var(--radius-full);
  margin-bottom: var(--spacing-md);
}

.step-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.step-desc {
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.7;
  display: block;
}

.step-tips {
  display: flex;
  align-items: flex-start;
  background: var(--color-warning-light);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
  margin-top: var(--spacing-lg);
}

.tips-icon {
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
}

.tips-text {
  font-size: var(--font-sm);
  color: #B8860B;
  line-height: 1.6;
}

/* 步骤导航 */
.step-nav {
  display: flex;
  justify-content: space-between;
  margin-top: var(--spacing-lg);
}

.step-nav-btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-primary);
  background: var(--color-primary-light);
  transition: all 0.2s ease;
}

.step-nav-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.step-nav-btn:active {
  background: var(--color-primary);
  color: white;
}

/* 记录按钮区域 */
.record-section {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-lg);
  background: var(--color-bg);
}

.record-btn {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  border-radius: var(--radius-xl);
  transition: all 0.2s ease;
}

.record-btn.success {
  background: var(--color-success);
  color: white;
}

.record-btn.attempt {
  background: var(--color-card);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border);
}

.record-btn:active {
  transform: scale(0.95);
}

.record-icon {
  font-size: 48rpx;
  margin-bottom: var(--spacing-xs);
}

.record-text {
  font-size: var(--font-sm);
  font-weight: 500;
}

/* 底部操作区 */
.action-section {
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg);
}

.btn-large {
  height: 100rpx;
  line-height: 100rpx;
  font-size: var(--font-lg);
  font-weight: 600;
}

/* 完成弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.complete-modal {
  width: 600rpx;
  background: var(--color-card);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  animation: modalIn 0.3s ease;
}

@keyframes modalIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-header {
  text-align: center;
  margin-bottom: var(--spacing-xl);
}

.modal-emoji {
  font-size: 80rpx;
  display: block;
  margin-bottom: var(--spacing-sm);
}

.modal-title {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 统计数据 */
.modal-stats {
  background: var(--color-bg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-md);
  margin-bottom: var(--spacing-xl);
}

.stat-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
}

.stat-row:not(:last-child) {
  border-bottom: 2rpx solid var(--color-border);
}

.stat-label {
  font-size: var(--font-md);
  color: var(--color-text-muted);
}

.stat-value {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.stat-value.highlight {
  color: var(--color-success);
  font-size: var(--font-lg);
}

.modal-footer {
  display: flex;
  flex-direction: column;
}

.mt-md {
  margin-top: var(--spacing-md);
}

