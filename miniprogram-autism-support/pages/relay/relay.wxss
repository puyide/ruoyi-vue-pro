/* pages/relay/relay.wxss */
.relay-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: var(--color-bg);
}

/* 导航栏 */
.nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-card);
}

.nav-back { width: 64rpx; }
.back-icon { font-size: var(--font-xl); color: var(--color-text-primary); }
.nav-title { font-size: var(--font-lg); font-weight: 600; color: var(--color-text-primary); }
.nav-placeholder { width: 64rpx; }

/* 发布区域 */
.publish-section {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  padding: var(--spacing-lg);
  margin: var(--spacing-md);
  border-radius: var(--radius-lg);
  text-align: center;
}

.publish-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) var(--spacing-xl);
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: white;
  border-radius: var(--radius-full);
  font-size: var(--font-md);
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);
}

.publish-btn::after { border: none; }

.publish-icon {
  font-size: var(--font-xl);
  margin-right: 8rpx;
  font-weight: 300;
}

.publish-tip {
  display: block;
  margin-top: var(--spacing-sm);
  font-size: var(--font-sm);
  color: #388E3C;
}

/* 筛选栏 */
.filter-bar {
  background: var(--color-card);
  padding: var(--spacing-md);
  border-bottom: 2rpx solid var(--color-border);
}

.filter-scroll {
  display: flex;
  white-space: nowrap;
  margin-bottom: var(--spacing-sm);
}

.filter-item {
  display: inline-flex;
  padding: var(--spacing-xs) var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-full);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-right: var(--spacing-sm);
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.filter-item.active {
  background: var(--color-primary);
  color: white;
}

.filter-actions {
  display: flex;
  gap: var(--spacing-md);
}

.filter-dropdown {
  display: flex;
  align-items: center;
  padding: var(--spacing-xs) var(--spacing-md);
  background: var(--color-bg);
  border-radius: var(--radius-md);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.dropdown-arrow {
  font-size: var(--font-xs);
  margin-left: 8rpx;
  color: var(--color-text-muted);
}

/* 好物列表 */
.item-scroll {
  flex: 1;
  padding: var(--spacing-md);
}

.item-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.item-card {
  display: flex;
  padding: 0;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.item-card:active {
  transform: scale(0.99);
}

/* 好物图片 */
.item-image-wrapper {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  position: relative;
}

.item-image {
  width: 100%;
  height: 100%;
}

.item-method-badge {
  position: absolute;
  top: var(--spacing-sm);
  left: var(--spacing-sm);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  font-weight: 500;
  color: white;
}

.item-method-badge.give {
  background: #4CAF50;
}

.item-method-badge.borrow {
  background: #2196F3;
}

.item-method-badge.sell {
  background: #FF9800;
}

/* 好物信息 */
.item-info {
  flex: 1;
  padding: var(--spacing-md);
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: var(--font-md);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: var(--spacing-sm);
}

.item-tag {
  font-size: var(--font-xs);
  padding: 4rpx 10rpx;
  border-radius: var(--radius-sm);
}

.item-tag.condition {
  background: var(--color-warning-light);
  color: #D68F00;
}

.item-tag.type {
  background: var(--color-secondary-light);
  color: var(--color-secondary);
}

.item-meta {
  margin-bottom: var(--spacing-sm);
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.meta-icon {
  margin-right: 4rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: auto;
  padding-top: var(--spacing-sm);
  border-top: 2rpx solid var(--color-border);
}

.giver-info {
  display: flex;
  align-items: center;
}

.avatar-text {
  font-size: var(--font-xs);
  font-weight: 600;
  color: var(--color-primary);
}

.giver-name {
  margin-left: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-muted);
}

.relay-btn {
  display: flex;
  align-items: center;
  color: var(--color-primary);
  font-size: var(--font-sm);
  font-weight: 500;
}

.btn-arrow {
  font-size: var(--font-lg);
  margin-left: 4rpx;
}

/* 加载状态 */
.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

.loading-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--color-border);
  border-top-color: var(--color-primary);
  border-radius: 50%;
  margin-right: var(--spacing-sm);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.no-more {
  text-align: center;
  padding: var(--spacing-lg);
  color: var(--color-text-muted);
  font-size: var(--font-sm);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-xl) 0;
}

.empty-icon { font-size: 100rpx; margin-bottom: var(--spacing-md); }
.empty-text { font-size: var(--font-md); color: var(--color-text-secondary); }
.empty-tip { font-size: var(--font-sm); color: var(--color-text-muted); margin-top: 8rpx; }

/* 筛选弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.filter-modal-content {
  width: 100%;
  background: var(--color-card);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: var(--spacing-lg);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.filter-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-lg);
  font-size: var(--font-lg);
  font-weight: 600;
}

.modal-close {
  font-size: var(--font-xl);
  color: var(--color-text-muted);
  padding: var(--spacing-sm);
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.filter-option {
  padding: var(--spacing-md) var(--spacing-lg);
  background: var(--color-bg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
}

.filter-option.selected {
  background: var(--color-primary-light);
  border-color: var(--color-primary);
  color: var(--color-primary);
}

/* 底部留白 */
.bottom-space { height: 40rpx; }

